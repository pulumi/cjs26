---
// SSR — uses the session to decide whether to render the auth form or the
// capture UI. Whether a photo *exists* is decided client-side after the
// page fetches /api/photo (KV's list-after-write is eventually consistent).
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { env } from "cloudflare:workers";

interface KVNamespace {
    list(options?: { limit?: number }): Promise<{ keys: { name: string }[] }>;
    get(key: string): Promise<string | null>;
}

const authed = (await Astro.session?.get<boolean>("authed")) === true;
// Set in /api/auth on successful login. Origin-scoped + outlives the session,
// so a signed-out owner of *this* card still sees the Edit button, while true
// anonymous visitors (and owners of other deployments) don't.
const hasEditedBefore = Astro.cookies.get("card_editor")?.value === "1";
// "Claimed" = anything exists in PHOTO_STORE. A first successful POST to
// /api/auth writes a `claimed` marker key there, so we treat the card as
// owned the moment the owner signs in (even before they save a photo).
// Subsequent saves (photo, OG, settings) also count. A fresh deploy has
// an empty store, so a new owner sees the Edit prompt to sign in.
const photoStore = (env as { PHOTO_STORE?: KVNamespace }).PHOTO_STORE;
const storeKeys = photoStore
    ? (await photoStore.list()).keys.map((k) => k.name)
    : [];
const claimed = storeKeys.length > 0;

// Render the personalized document <title> server-side too, so crawlers and
// social-media link previews (which read the initial HTML, not post-load JS)
// see it. Mirrors the client-side updatePageTitle(): personalized only once a
// photo is saved AND the name differs from the placeholder. The client still
// updates it live after a save, but the first paint already carries the right
// value. KV is eventually consistent, so this can briefly lag a fresh save —
// acceptable for a share-preview title.
const DEFAULT_NAME = "Cloud Watcher";
let pageTitle = "Member ID Card";
if (photoStore && storeKeys.includes("current")) {
    const raw = await photoStore.get("current.settings");
    if (raw) {
        try {
            const name = ((JSON.parse(raw) as { name?: string }).name ?? "").trim();
            if (name && name !== DEFAULT_NAME) pageTitle = `${name}, Official Member`;
        } catch {}
    }
}
// True under `astro dev`, false in the production build. Vite injects it.
const isDev = import.meta.env.DEV;
// The exact command the owner runs to read the production password.
const pulumiCmd = "pulumi stack output passkey --show-secrets";
---

<Layout title={pageTitle}>
    <header class="page-header">
        <span class="page-title">Pulumi cloud watching club ID card</span>
        {
            (authed || !claimed || hasEditedBefore) && (
                <button id="auth-toggle" type="button" class="btn btn-outline">
                    {authed ? "Log Out" : "Edit"}
                </button>
            )
        }
    </header>

    <section
        id="card"
        class="card"
        data-photo-phase="empty"
        data-authed={authed ? "1" : "0"}
    >
        <div class="card-left">
            <img
                src="/badge.svg"
                alt="Pulumi Cloud Watching Club — Official Member"
                class="badge"
            />
        </div>
        <div class="card-right">
            <div class="field field-name">
                <span class="field-label">Name</span>
                <span
                    id="name-value"
                    class="field-value"
                    spellcheck="false"
                    contenteditable={authed ? "plaintext-only" : "false"}
                >Cloud Watcher</span>
                {
                    authed && (
                        <button
                            id="save-changes"
                            type="button"
                            class="btn btn-solid btn-small"
                            hidden
                        >
                            Save Changes
                        </button>
                    )
                }
            </div>
            <div class="field field-exp">
                <span class="field-label">EXP</span>
                <span id="exp-value" class="field-value">––/––/––––</span>
            </div>
            <div class="photo-cell" id="photo-cell">
                <pre id="ascii-display" hidden></pre>
                <button
                    id="add-photo"
                    type="button"
                    class="btn btn-solid photo-btn-center"
                    hidden={!authed}>Add Photo</button
                >
                <div
                    id="photo-capture-controls"
                    class="photo-capture-controls"
                    hidden
                >
                    <button
                        id="save-photo"
                        type="button"
                        class="btn btn-solid"
                        hidden>Take Photo</button
                    >
                    <button id="toggle-cam" type="button" class="btn btn-solid"
                        >Open Webcam</button
                    >
                </div>
                <button
                    id="replace-photo"
                    type="button"
                    class="btn btn-solid photo-btn-center"
                    >Replace Photo</button
                >
            </div>
        </div>
    </section>

    <div class="card-footer">
        {
            authed ? (

                <a href="https://www.pulumi.com/cjs26" target="_blank" class="laptop-password">
                    Forest laptop password:
                </a>
                <span>W4TCHTHECL0UDS</span>
            ) : (
                <span />
            )
        }
        <div class="card-footer-actions">
            <button id="download" type="button" class="btn btn-outline"
                >Download</button
            >
            <a
                href="https://discord.gg/kkYR86GM29"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-solid">Share in Discord</a
            >
        </div>
    </div>
        {
            authed && (
                <div class="message-block">Congratulations on your membership! Stop by our booth for some special swag.</div>
            )
        }

    <span id="status" class="status" role="status" aria-live="polite"></span>

    <section id="auth" class="auth-card" hidden>
        <h2>Authenticate to edit</h2>
        {
            isDev ? (
                <p>
                    Local dev password: <code>dev</code>
                </p>
            ) : (
                <p>
                    Run the following to obtain your passkey,
                    then paste it below to log in:
                </p>
                <div class="copy-block">
                    <code>{pulumiCmd}</code>
                    <button
                        type="button"
                        id="copy-pulumi-cmd"
                        class="btn btn-outline btn-small"
                        data-cmd={pulumiCmd}
                    >
                        Copy
                    </button>
                </div>
            )
        }
        <form id="auth-form">
            <input
                id="password"
                type="password"
                name="password"
                autocomplete="off"
                required
                placeholder="Passkey"
            />
            <button type="submit" class="btn btn-solid">Log In</button>
            <button
                type="button"
                id="auth-cancel"
                class="btn btn-outline">Cancel</button
            >
        </form>
        <p id="auth-error" class="error" hidden></p>
    </section>

    <p class="page-footer">
        Built with <a href="https://astro.build">Astro</a> and <a href="https://github.com/mwpryer/ascii-ify" target="_blank"
            >ASCII-ify</a
        > and deployed with <a href="https://www.pulumi.com" target="_blank"
            >Pulumi</a
        >.
        [<a href="https://github.com/pulumi/cjs26" target="_blank">Source on GitHub</a>]
    </p>

    <!-- Hidden machinery -->
    <video id="video" autoplay playsinline muted hidden></video>
    <canvas id="work-canvas" hidden></canvas>

    <style>
        /* ---- Layout shell ------------------------------------------------- */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0 0.25rem;
            margin-bottom: 1.5rem;
        }
        .page-title {
            font-size: 1rem;
            letter-spacing: 0;
        }
        .page-footer {
            margin-top: auto;
            padding-top: 4rem;
            text-align: center;
            font-size: 0.875rem;
        }
        .page-footer a {
            text-decoration: underline;
        }

        /* ---- Buttons ------------------------------------------------------ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            white-space:nowrap;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-family:
                "Monaspace Neon Var", ui-monospace, "SF Mono", Menlo,
                monospace;
            font-size: 1rem;
            line-height: 1.5;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition: opacity 0.15s ease;
        }
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-outline {
            background: var(--color-service-black);
            border: 2px solid var(--color-violet-400);
            color: var(--color-violet-400);
        }
        .btn-solid {
            background: var(--color-violet-400);
            border: 2px solid var(--color-violet-400);
            color: var(--color-service-black);
        }
        .btn-small {
            min-height: 28px;
            padding: 0.2rem 0.6rem;
            font-size: 0.85rem;
        }
        .btn:not(:disabled):hover {
            opacity: 0.85;
        }

        /* ---- Card --------------------------------------------------------- */
        .card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border: 4px solid var(--color-violet-400);
            /* Match 1200×630 so the live card and the og:image PNG share an
               aspect. Combined with the field/photo flex ratios below, the
               photo region also matches the OG canvas. */
            aspect-ratio: 1200 / 630;
            border-radius: 16px;
            overflow: hidden;
        }
        .card-left {
            border-right: 2px solid var(--color-violet-400);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.25rem;
            background-image: url("/wave-bg.svg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
        .badge {
            width: auto;
            height: auto;
            max-width: min(100%, 280px);
            max-height: 100%;
            display: block;
        }
        .card-right {
            display: flex;
            flex-direction: column;
        }
        .field {
            border-bottom: 2px solid var(--color-violet-400);
            padding: 15px 27px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .field-name {
            position: relative;
        }
        #save-changes {
            position: absolute;
            top: 12px;
            right: 12px;
        }
        .field-label {
            font-size: 1rem;
            line-height: 1;
        }
        .field-value {
            font-size: 1.25rem;
            line-height: 1;
            text-transform: none;
            outline: none;
            min-height: 1.25rem;
        }
        .field-value[contenteditable="plaintext-only"]:focus {
            outline: 1px dashed
                color-mix(in srgb, var(--color-violet-400) 60%, transparent);
            outline-offset: 4px;
        }

        /* ---- Photo cell --------------------------------------------------- */
        .photo-cell {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            min-width: 0;
            min-height: 0;
        }
        #ascii-display {
            font-family:
                "Monaspace Neon Var", ui-monospace, "SF Mono", Menlo, monospace;
            margin: 0;
            padding: 0;
            white-space: pre;
            text-align: center;
            text-shadow: 0 0 6px rgba(166, 151, 252, 0.7);
            /* font-size + line-height set inline via JS to fit the cell. */
        }
        .photo-btn-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
        }
        #add-photo.photo-btn-center,
        #replace-photo.photo-btn-center {
            top: auto;
            bottom: 0.75rem;
            transform: translateX(-50%);
        }
        .photo-capture-controls {
            position: absolute;
            bottom: 0.75rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }

        /* Phase: empty (no saved photo, not capturing) — ADD PHOTO only. */
        #card[data-photo-phase="empty"] #ascii-display,
        #card[data-photo-phase="empty"] #photo-capture-controls,
        #card[data-photo-phase="empty"] #replace-photo {
            display: none !important;
        }
        /* Phase: capturing — preview + Open/Save controls. */
        #card[data-photo-phase="capturing"] #add-photo,
        #card[data-photo-phase="capturing"] #replace-photo {
            display: none !important;
        }
        #card[data-photo-phase="capturing"] #ascii-display:not([hidden]) {
            display: block;
        }
        /* Phase: saved — just the photo; hover reveals Replace (when authed). */
        #card[data-photo-phase="saved"] #add-photo,
        #card[data-photo-phase="saved"] #photo-capture-controls {
            display: none !important;
        }
        #card[data-photo-phase="saved"] #replace-photo {
            display: none;
        }
        #card[data-photo-phase="saved"][data-authed="1"]
            .photo-cell:hover
            #replace-photo,
        #card[data-photo-phase="saved"][data-authed="1"]
            .photo-cell:focus-within
            #replace-photo {
            display: inline-flex;
        }
        /* Unauthed visitors with no saved photo see an empty cell. */
        #card[data-authed="0"] #add-photo {
            display: none !important;
        }

        /* ---- Card footer -------------------------------------------------- */
        .card-footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .laptop-password {
            font-size: 1rem;
            text-decoration:underline;
        }
        .card-footer-actions {
            display: flex;
            flex: 1;
            justify-content: flex-end;
            gap: 1rem;
        }
        .message-block {
            border: 1px solid var(--color-violet-400);
            border-radius: 16px;
            padding: 1rem 1.25rem;
            margin-top: 1.5rem;
            text-align: center;
        }

        /* ---- Status / auth ----------------------------------------------- */
        .status {
            display: block;
            min-height: 1.25rem;
            margin-top: 1rem;
            font-size: 0.85rem;
            opacity: 0.75;
            text-align: right;
        }
        .auth-card {
            border: 2px solid var(--color-violet-400);
            border-radius: 8px;
            padding: 1.5rem;
            margin-top: 2rem;
        }
        .auth-card h2 {
            margin: 0 0 0.75rem;
            font-size: 1.1rem;
        }
        .auth-card p {
            margin: 0.5rem 0;
        }
        .auth-card form {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }
        .auth-card input[type="password"] {
            padding: 0.5rem 0.75rem;
            border-radius: 8px;
            border: 2px solid var(--color-violet-400);
            background: var(--color-service-black);
            color: inherit;
            font: inherit;
            text-transform: none;
            min-width: 14rem;
            outline: none;
            caret-color: #fff;
        }
        .auth-card input[type="password"]:focus,
        .auth-card input[type="password"]:focus-visible {
            outline: none;
            border-color: #fff;
        }
        .copy-block {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            background: color-mix(in srgb, currentColor 8%, transparent);
            padding: 0.5rem 0.65rem;
            border-radius: 8px;
            margin: 0.5rem 0 0;
            overflow: hidden;
            text-transform: none;
        }
        .copy-block code {
            background: transparent;
            padding: 0;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow-x: auto;
            flex: 1;
        }
        .error {
            color: #ff6b6b;
            font-size: 0.9rem;
        }

        @media (max-width: 700px) {
            .card {
                grid-template-columns: 1fr;
                aspect-ratio: auto;
            }
            .card-left {
                border-right: 0;
                border-bottom: 2px solid var(--color-violet-400);
                aspect-ratio: 1 / 1;
            }
        }
    </style>

    <script>
        import { canvasToAscii, type AsciiOptions } from "../lib/ascii.ts";

        // --- Character ramp presets ---------------------------------------------
        const CHAR_PRESETS = {
            blocks: "█▓▒░ ",
            detailed:
                "$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,\"^`'. ",
            basic: "@%#*+=-:. ",
        } as const;
        type CharsPreset = keyof typeof CHAR_PRESETS;

        type Settings = {
            color: string;
            chars: CharsPreset;
            contrast: number;
            brightness: number;
            name: string;
            exp: string;
        };

        // Matches --color-violet-400 in the layout. Fixed for everyone —
        // the per-user tuning UI is gone, so the renderer always uses these.
        const settings: Settings = {
            color: "#a697fc",
            chars: "blocks",
            contrast: 100,
            brightness: 0,
            name: "Cloud Watcher",
            exp: "",
        };

        // ASCII grid + webcam crop both use 4:3, matching the photo-cell's
        // aspect-ratio so the ASCII fills the cell with no letterboxing.
        const GRID_W = 200;
        const GRID_H = 150;
        const TARGET_ASPECT = GRID_W / GRID_H;
        // Card / og:image canvas dimensions (standard og:image).
        const OG_PX_W = 1200;
        const OG_PX_H = 630;

        const VIOLET = "#a697fc";
        const SERVICE_BLACK = "#1f1b21";

        function formatExp(d: Date): string {
            const mm = String(d.getMonth() + 1).padStart(2, "0");
            const dd = String(d.getDate()).padStart(2, "0");
            return `${mm}/${dd}/${d.getFullYear()}`;
        }
        function expTenYearsOut(): string {
            const d = new Date();
            d.setFullYear(d.getFullYear() + 10);
            return formatExp(d);
        }

        function asciiOptions(gridW: number, gridH: number): AsciiOptions {
            return {
                width: gridW,
                height: gridH,
                chars: CHAR_PRESETS[settings.chars],
                contrast: settings.contrast / 100,
                brightness: settings.brightness / 100,
            };
        }

        // Center-crop `src` to `gridW × gridH`'s aspect ratio, draw the crop into
        // the shared work canvas (scaled up to give the ASCII algorithm enough
        // pixels to sample), then convert to ASCII text.
        function asciiFromSource(
            src: CanvasImageSource,
            srcW: number,
            srcH: number,
            gridW: number,
            gridH: number,
        ): string {
            const targetAspect = gridW / gridH;
            const srcAspect = srcW / srcH;
            let cropW = srcW,
                cropH = srcH,
                cropX = 0,
                cropY = 0;
            if (srcAspect > targetAspect) {
                cropW = Math.round(srcH * targetAspect);
                cropX = Math.floor((srcW - cropW) / 2);
            } else if (srcAspect < targetAspect) {
                cropH = Math.round(srcW / targetAspect);
                cropY = Math.floor((srcH - cropH) / 2);
            }
            const workW = gridW * 2;
            const workH = gridH * 2;
            workCanvas.width = workW;
            workCanvas.height = workH;
            const ctx = workCanvas.getContext("2d");
            if (!ctx) throw new Error("No 2D context");
            ctx.drawImage(src, cropX, cropY, cropW, cropH, 0, 0, workW, workH);
            return canvasToAscii(workCanvas, asciiOptions(gridW, gridH));
        }

        async function blobToCanvas(blob: Blob): Promise<HTMLCanvasElement> {
            const bitmap = await createImageBitmap(blob);
            const c = document.createElement("canvas");
            c.width = bitmap.width;
            c.height = bitmap.height;
            c.getContext("2d")!.drawImage(bitmap, 0, 0);
            bitmap.close();
            return c;
        }

        // --- DOM ----------------------------------------------------------------
        const card = document.getElementById("card") as HTMLElement;
        const authed = card.dataset.authed === "1";
        const asciiDisplay = document.getElementById(
            "ascii-display",
        ) as HTMLPreElement;
        const photoCell = document.getElementById("photo-cell") as HTMLElement;
        const addPhotoBtn = document.getElementById(
            "add-photo",
        ) as HTMLButtonElement | null;
        const replacePhotoBtn = document.getElementById(
            "replace-photo",
        ) as HTMLButtonElement | null;
        const captureControls = document.getElementById(
            "photo-capture-controls",
        ) as HTMLElement;
        const toggleCamBtn = document.getElementById(
            "toggle-cam",
        ) as HTMLButtonElement | null;
        const savePhotoBtn = document.getElementById(
            "save-photo",
        ) as HTMLButtonElement | null;
        const nameValue = document.getElementById(
            "name-value",
        ) as HTMLElement;
        const expValue = document.getElementById("exp-value") as HTMLElement;
        const saveChangesBtn = document.getElementById(
            "save-changes",
        ) as HTMLButtonElement | null;
        const downloadBtn = document.getElementById(
            "download",
        ) as HTMLButtonElement;
        const authToggleBtn = document.getElementById(
            "auth-toggle",
        ) as HTMLButtonElement | null;
        const authSection = document.getElementById(
            "auth",
        ) as HTMLElement | null;
        const authCancelBtn = document.getElementById(
            "auth-cancel",
        ) as HTMLButtonElement | null;
        const status = document.getElementById("status") as HTMLElement;
        const video = document.getElementById("video") as HTMLVideoElement;
        const workCanvas = document.getElementById(
            "work-canvas",
        ) as HTMLCanvasElement;
        const setStatus = (s: string) => {
            status.textContent = s;
        };
        const setPhase = (p: "empty" | "capturing" | "saved") => {
            card.dataset.photoPhase = p;
        };

        // --- Render state -------------------------------------------------------
        type Mode = "idle" | "photo" | "live";
        let mode: Mode = "idle";
        let cachedSourceCanvas: HTMLCanvasElement | null = null;
        let stream: MediaStream | null = null;
        let rafId: number | null = null;
        let liveStyleApplied = false;

        // Auto-size the ASCII font to fill the photo cell. Pick the largest
        // font where the GRID_W × GRID_H grid fits in both axes of the cell.
        function applyDisplayStyle() {
            asciiDisplay.style.color = settings.color;
            const cellW = photoCell.clientWidth || 350;
            const cellH = photoCell.clientHeight || 195;
            const sizeByW = cellW / (GRID_W * 0.6);
            const sizeByH = cellH / (GRID_H * 0.6);
            const size = Math.max(1, Math.min(sizeByW, sizeByH));
            asciiDisplay.style.fontSize = `${size}px`;
            asciiDisplay.style.lineHeight = `${size * 0.6}px`;
            asciiDisplay.style.transformOrigin = "center center";
            // Measure the actual rendered pre and scale it to fill the cell
            // on both axes. The 0.6 char-width / line-height heuristic above
            // is approximate (and notably off for Safari's rendering of
            // Monaspace Neon), so we don't trust it for the stretch — we
            // observe the real box. getBoundingClientRect forces layout, so
            // measurement is up-to-date with the font + content we just set.
            asciiDisplay.style.transform = "none";
            if (!asciiDisplay.hidden && asciiDisplay.textContent) {
                const r = asciiDisplay.getBoundingClientRect();
                if (r.width > 0 && r.height > 0) {
                    asciiDisplay.style.transform =
                        `scale(${cellW / r.width}, ${cellH / r.height})`;
                }
            }
        }

        function renderPhotoFromCache() {
            if (!cachedSourceCanvas) return;
            asciiDisplay.textContent = asciiFromSource(
                cachedSourceCanvas,
                cachedSourceCanvas.width,
                cachedSourceCanvas.height,
                GRID_W,
                GRID_H,
            );
            asciiDisplay.hidden = false;
            applyDisplayStyle();
        }

        function renderLiveFrame() {
            if (!stream || !video.videoWidth) return;
            asciiDisplay.textContent = asciiFromSource(
                video,
                video.videoWidth,
                video.videoHeight,
                GRID_W,
                GRID_H,
            );
            asciiDisplay.hidden = false;
            // The pre's dimensions don't change frame-to-frame (grid is
            // fixed), so we only need to re-fit once after content first
            // appears. ResizeObserver covers cell-size changes.
            if (!liveStyleApplied) {
                liveStyleApplied = true;
                applyDisplayStyle();
            }
        }

        function liveLoop() {
            renderLiveFrame();
            if (mode === "live") rafId = requestAnimationFrame(liveLoop);
        }

        // --- Settings persistence (server-side only; no localStorage) ---------
        async function loadServerSettings(): Promise<void> {
            const res = await fetch("/api/settings", { cache: "no-store" });
            if (!res.ok) return;
            try {
                const incoming = (await res.json()) as Partial<Settings>;
                Object.assign(settings, incoming);
            } catch {}
        }

        async function postSettings(): Promise<void> {
            await fetch("/api/settings", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify(settings),
            });
        }

        function applyNameAndExpToUI() {
            nameValue.textContent = settings.name;
            expValue.textContent = settings.exp || expTenYearsOut();
        }

        // Personalize the document <title> once the card is both named and has
        // a saved photo. Public visitors get the same personalized title after
        // the photo fetch resolves; it falls back to the default title while
        // the name is still the placeholder or no photo has been saved yet.
        const DEFAULT_NAME = "Cloud Watcher";
        const DEFAULT_TITLE = "Member ID Card";
        // Mirrors the `· Pulumi Cloud Watching Club` suffix in Layout.astro.
        const TITLE_SUFFIX = " · Pulumi Cloud Watching Club";

        function updatePageTitle() {
            const name = (settings.name || "").trim();
            const personalized =
                mode === "photo" && name !== "" && name !== DEFAULT_NAME;
            const title = personalized
                ? `${name}, Official Member`
                : DEFAULT_TITLE;
            document.title = title + TITLE_SUFFIX;
        }

        // Focus the (editable) Name field and select its text so the owner can
        // type over the placeholder. No-op when the name isn't editable.
        function focusNameField() {
            if (nameValue.getAttribute("contenteditable") !== "plaintext-only")
                return;
            nameValue.focus();
            const range = document.createRange();
            range.selectNodeContents(nameValue);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
        }

        // --- Load saved photo on first paint -----------------------------------
        async function loadPhoto(): Promise<void> {
            const res = await fetch("/api/photo", { cache: "no-store" });
            if (!res.ok) {
                return;
            }
            if (mode === "live") return;
            const blob = await res.blob();
            cachedSourceCanvas = await blobToCanvas(blob);
            mode = "photo";
            applyDisplayStyle();
            renderPhotoFromCache();
            setPhase("saved");
        }

        async function init() {
            applyDisplayStyle();
            await loadServerSettings();
            applyNameAndExpToUI();
            // Right after login the page reloads with this flag set — focus the
            // Name field so the owner can name their card immediately.
            if (authed && sessionStorage.getItem("focus-name") === "1") {
                sessionStorage.removeItem("focus-name");
                focusNameField();
            }
            await loadPhoto();
            // If settings came back from KV after loadPhoto, re-render to apply
            // any color/chars change in case future tuning is reintroduced.
            if (mode === "photo") {
                applyDisplayStyle();
                renderPhotoFromCache();
            }
            updatePageTitle();
        }
        init();

        // The font-size calc depends on the photo cell's final layout, which
        // settles after CSS arrives, after the web font swaps, and on every
        // viewport resize. ResizeObserver covers all three.
        new ResizeObserver(() => {
            applyDisplayStyle();
        }).observe(photoCell);
        document.fonts?.ready.then(() => {
            applyDisplayStyle();
        });

        // --- Name editing ------------------------------------------------------
        if (authed && saveChangesBtn) {
            nameValue.addEventListener("input", () => {
                saveChangesBtn.hidden = false;
                saveChangesBtn.textContent = "Save Changes";
                setStatus("");
            });
            // Plain text only — strip line breaks on paste.
            nameValue.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    nameValue.blur();
                }
            });

            saveChangesBtn.addEventListener("click", async () => {
                saveChangesBtn.disabled = true;
                settings.name =
                    (nameValue.textContent || "").trim() || "Cloud Watcher";
                nameValue.textContent = settings.name;
                settings.exp = expTenYearsOut();
                expValue.textContent = settings.exp;
                updatePageTitle();
                try {
                    await postSettings();
                    // Refresh the share card so the new name flows through
                    // to /api/og.png. Best-effort: failure doesn't block
                    // the saved-state flip below.
                    try {
                        await postCardOg();
                    } catch {}
                    saveChangesBtn.textContent = "Changes Saved";
                    setTimeout(() => {
                        saveChangesBtn.hidden = true;
                        saveChangesBtn.textContent = "Save Changes";
                        saveChangesBtn.disabled = false;
                    }, 1200);
                } catch (err) {
                    setStatus(`Save failed: ${(err as Error).message}`);
                    saveChangesBtn.disabled = false;
                }
            });
        }

        // --- Auth header button ------------------------------------------------
        authToggleBtn?.addEventListener("click", async () => {
            if (authed) {
                // Sign Out
                const res = await fetch("/api/auth", { method: "DELETE" });
                if (res.ok) location.reload();
                return;
            }
            // Sign In → reveal the auth form below the card and scroll to it.
            if (authSection) {
                authSection.hidden = false;
                authSection.scrollIntoView({ behavior: "smooth", block: "start" });
                (document.getElementById("password") as HTMLInputElement)?.focus();
            }
        });

        authCancelBtn?.addEventListener("click", () => {
            if (authSection) authSection.hidden = true;
        });

        // Backdoor URL for the owner: /edit renders this page with the auth
        // form revealed, even though the Edit button is hidden from public
        // viewers. (The /edit route rewrites to "/", so the markup is shared.)
        if (!authed && location.pathname.replace(/\/$/, "") === "/edit" && authSection) {
            authSection.hidden = false;
            authSection.scrollIntoView({ behavior: "smooth", block: "start" });
            (document.getElementById("password") as HTMLInputElement)?.focus();
        }

        // --- Auth form ---------------------------------------------------------
        const authForm = document.getElementById(
            "auth-form",
        ) as HTMLFormElement | null;
        const authError = document.getElementById("auth-error");
        authForm?.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (authError) authError.hidden = true;
            const password = (
                document.getElementById("password") as HTMLInputElement
            ).value;
            const res = await fetch("/api/auth", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ password }),
            });
            if (res.ok) {
                // One-shot flag so the reloaded page focuses the Name field,
                // letting the owner edit their name straight after logging in.
                sessionStorage.setItem("focus-name", "1");
                location.href = "/";
            } else if (authError) {
                authError.textContent = "Wrong password.";
                authError.hidden = false;
            }
        });

        // --- Copy the pulumi command (production auth instructions) -----------
        const copyPulumiBtn = document.getElementById(
            "copy-pulumi-cmd",
        ) as HTMLButtonElement | null;
        copyPulumiBtn?.addEventListener("click", async () => {
            const cmd = copyPulumiBtn.dataset.cmd ?? "";
            const original = copyPulumiBtn.textContent ?? "Copy";
            try {
                await navigator.clipboard.writeText(cmd);
                copyPulumiBtn.textContent = "Copied!";
            } catch {
                copyPulumiBtn.textContent = "Copy failed";
            }
            setTimeout(() => {
                copyPulumiBtn.textContent = original;
            }, 1500);
        });

        // --- Photo cell phases -------------------------------------------------
        function enterCaptureMode() {
            setPhase("capturing");
            captureControls.hidden = false;
            asciiDisplay.hidden = true;
            applyDisplayStyle();
            if (savePhotoBtn) {
                savePhotoBtn.hidden = true;
                savePhotoBtn.disabled = false;
            }
            setCamButtonLabel(false);
        }

        addPhotoBtn?.addEventListener("click", enterCaptureMode);
        replacePhotoBtn?.addEventListener("click", enterCaptureMode);

        // --- Webcam ------------------------------------------------------------
        function setCamButtonLabel(open: boolean) {
            if (toggleCamBtn)
                toggleCamBtn.textContent = open ? "Cancel" : "Open Webcam";
        }

        function closeCam() {
            if (rafId !== null) cancelAnimationFrame(rafId);
            rafId = null;
            liveStyleApplied = false;
            stream?.getTracks().forEach((t) => t.stop());
            stream = null;
            video.srcObject = null;
            setCamButtonLabel(false);
            if (savePhotoBtn) savePhotoBtn.hidden = true;
            captureControls.hidden = true;
            if (cachedSourceCanvas) {
                mode = "photo";
                renderPhotoFromCache();
                setPhase("saved");
            } else {
                mode = "idle";
                asciiDisplay.hidden = true;
                asciiDisplay.textContent = "";
                setPhase("empty");
            }
        }

        async function openCam() {
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: 640, height: 480 },
                });
                video.srcObject = stream;
                await video.play();
                mode = "live";
                if (savePhotoBtn) savePhotoBtn.hidden = false;
                setCamButtonLabel(true);
                applyDisplayStyle();
                if (rafId !== null) cancelAnimationFrame(rafId);
                liveLoop();
                setStatus("Streaming live ASCII…");
            } catch (err) {
                setStatus(`Camera error: ${(err as Error).message}`);
            }
        }

        toggleCamBtn?.addEventListener("click", () => {
            if (stream) closeCam();
            else openCam();
        });

        // The OG image is just the full card render — the same PNG the
        // Download button produces. Stored under `current.og` in KV and
        // served by /api/og.png. Requires the asciiDisplay to already hold
        // the latest photo text (caller's responsibility).
        async function postCardOg(): Promise<void> {
            const blob = await renderCardPng();
            const res = await fetch("/api/photo", {
                method: "POST",
                headers: { "content-type": "image/png" },
                body: blob,
            });
            if (!res.ok) throw new Error(`OG POST ${res.status}`);
        }

        savePhotoBtn?.addEventListener("click", async () => {
            if (mode === "live" && stream && video.videoWidth) {
                savePhotoBtn.disabled = true;
                setStatus("Saving…");

                const srcW = video.videoWidth,
                    srcH = video.videoHeight;
                const srcAspect = srcW / srcH;
                let cropW = srcW,
                    cropH = srcH,
                    cropX = 0,
                    cropY = 0;
                if (srcAspect > TARGET_ASPECT) {
                    cropW = Math.round(srcH * TARGET_ASPECT);
                    cropX = Math.floor((srcW - cropW) / 2);
                } else if (srcAspect < TARGET_ASPECT) {
                    cropH = Math.round(srcW / TARGET_ASPECT);
                    cropY = Math.floor((srcH - cropH) / 2);
                }
                const c = document.createElement("canvas");
                c.width = cropW;
                c.height = cropH;
                c.getContext("2d")?.drawImage(
                    video,
                    cropX,
                    cropY,
                    cropW,
                    cropH,
                    0,
                    0,
                    cropW,
                    cropH,
                );
                const jpeg: Blob = await new Promise((resolve, reject) =>
                    c.toBlob(
                        (b) =>
                            b ? resolve(b) : reject(new Error("toBlob failed")),
                        "image/jpeg",
                        0.85,
                    ),
                );

                const jpegRes = await fetch("/api/photo", {
                    method: "POST",
                    headers: { "content-type": "image/jpeg" },
                    body: jpeg,
                });
                if (!jpegRes.ok) {
                    setStatus(`Save failed: ${jpegRes.status}`);
                    if (savePhotoBtn) savePhotoBtn.disabled = false;
                    return;
                }

                cachedSourceCanvas = await blobToCanvas(jpeg);
                // Populate the ASCII display from the new source before we
                // snapshot the card — renderCardPng reads asciiDisplay.
                mode = "photo";
                renderPhotoFromCache();
                settings.exp = expTenYearsOut();
                expValue.textContent = settings.exp;
                updatePageTitle();

                let ogOk = true;
                let ogErr: Error | null = null;
                try {
                    setStatus("Rendering OG…");
                    await postCardOg();
                    await postSettings();
                } catch (err) {
                    ogOk = false;
                    ogErr = err as Error;
                }

                closeCam();
                setPhase("saved");
                renderPhotoFromCache();
                setStatus(
                    ogOk ? "Saved." : `Photo saved; OG failed: ${ogErr?.message}`,
                );
                return;
            }
        });

        // --- Download card as PNG ---------------------------------------------
        async function loadBadgeImage(): Promise<HTMLImageElement> {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = "anonymous";
                img.onload = () => resolve(img);
                img.onerror = () => reject(new Error("badge load failed"));
                img.src = "/badge.svg";
            });
        }

        async function renderCardPng(): Promise<Blob> {
            // Standard og:image / social card size. The internal layout is
            // designed at a 696×369 baseline; SCALE maps that into 1200×630
            // (the same ratio — 1200/630 ≈ 696/369 ≈ 1.905).
            const W = OG_PX_W;
            const H = OG_PX_H;
            const SCALE = W / 696;
            const BORDER = 4 * SCALE;
            const DIVIDER = 2 * SCALE;

            const c = document.createElement("canvas");
            c.width = W;
            c.height = H;
            const ctx = c.getContext("2d");
            if (!ctx) throw new Error("No 2D context");

            // Ensure font is loaded before drawing text.
            await document.fonts.load(`${20 * SCALE}px "Monaspace Neon Var"`);

            // Background + outer border.
            ctx.fillStyle = SERVICE_BLACK;
            ctx.fillRect(0, 0, W, H);
            ctx.strokeStyle = VIOLET;
            ctx.lineWidth = BORDER;
            ctx.strokeRect(BORDER / 2, BORDER / 2, W - BORDER, H - BORDER);

            // Vertical divider between left/right halves.
            const leftW = Math.round(W * (347 / 696));
            ctx.fillStyle = VIOLET;
            ctx.fillRect(leftW - DIVIDER / 2, 0, DIVIDER, H);

            // Badge on the left.
            try {
                const badge = await loadBadgeImage();
                const padding = 20 * SCALE;
                const availW = leftW - padding * 2;
                const availH = H - padding * 2;
                const badgeAspect = badge.width / badge.height;
                let bw = availW;
                let bh = bw / badgeAspect;
                if (bh > availH) {
                    bh = availH;
                    bw = bh * badgeAspect;
                }
                ctx.drawImage(
                    badge,
                    (leftW - bw) / 2,
                    (H - bh) / 2,
                    bw,
                    bh,
                );
            } catch {
                // Skip badge if it fails to load — the rest of the card is
                // still valuable.
            }

            // Right column: NAME / EXP / PHOTO with 2px horizontal dividers.
            const rightX = leftW + DIVIDER / 2;
            const rightW = W - rightX;
            const fieldH = 87 * SCALE;
            const padX = 27 * SCALE;
            const padTop = 15 * SCALE;
            const labelSize = 16 * SCALE;
            const valueSize = 20 * SCALE;
            const gap = 14 * SCALE;

            const drawField = (y: number, label: string, value: string) => {
                ctx.fillStyle = VIOLET;
                ctx.textBaseline = "top";
                ctx.font = `${labelSize}px "Monaspace Neon Var", ui-monospace, monospace`;
                ctx.fillText(label.toUpperCase(), rightX + padX, y + padTop);
                ctx.font = `${valueSize}px "Monaspace Neon Var", ui-monospace, monospace`;
                ctx.fillText(
                    value,
                    rightX + padX,
                    y + padTop + labelSize + gap,
                );
                // Bottom divider.
                ctx.fillRect(rightX, y + fieldH - DIVIDER / 2, rightW, DIVIDER);
            };

            drawField(0, "Name", settings.name);
            drawField(fieldH, "EXP", settings.exp || expTenYearsOut());

            // Photo region: bottom of right column.
            const photoY = fieldH * 2;
            const photoH = H - photoY;
            const photoX = rightX;
            const photoW = rightW;

            const asciiText = asciiDisplay.textContent || "";
            if (asciiText) {
                const lines = asciiText.split("\n");
                // Fit text to the photo region.
                const cellPadding = 8 * SCALE;
                const availW = photoW - cellPadding * 2;
                const availH = photoH - cellPadding * 2;
                const rowsCount = lines.length;
                let fontSize = availH / rowsCount / 0.6;
                ctx.font = `${fontSize}px "Monaspace Neon Var", ui-monospace, monospace`;
                const widest = lines.reduce(
                    (m, l) => Math.max(m, ctx.measureText(l).width),
                    0,
                );
                if (widest > availW) {
                    fontSize *= availW / widest;
                    ctx.font = `${fontSize}px "Monaspace Neon Var", ui-monospace, monospace`;
                }
                const rowHeight = fontSize * 0.6;
                const totalH = rowHeight * rowsCount;
                const finalWidest = lines.reduce(
                    (m, l) => Math.max(m, ctx.measureText(l).width),
                    0,
                );
                const xOff = photoX + (photoW - finalWidest) / 2;
                const yOff = photoY + (photoH - totalH) / 2;
                ctx.fillStyle = VIOLET;
                ctx.textBaseline = "top";
                for (let i = 0; i < lines.length; i++) {
                    ctx.fillText(lines[i], xOff, yOff + i * rowHeight);
                }
            }

            return new Promise((resolve, reject) =>
                c.toBlob(
                    (b) =>
                        b ? resolve(b) : reject(new Error("toBlob failed")),
                    "image/png",
                ),
            );
        }

        downloadBtn.addEventListener("click", async () => {
            downloadBtn.disabled = true;
            try {
                const blob = await renderCardPng();
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "pulumi-cloud-watchers-id.png";
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            } catch (err) {
                setStatus(`Download failed: ${(err as Error).message}`);
            } finally {
                downloadBtn.disabled = false;
            }
        });
    </script>
</Layout>
</content>
</invoke>
