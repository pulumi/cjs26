---
interface Props {
    title: string;
    tagline?: string;
}
const { title, tagline } = Astro.props;
const fullTitle = `${title} · Pulumi Cloud Watching Club`;
const description =
    tagline ?? "Build and deploy a card of your own at pulumi.com/cjs26.";
// Absolute URL so crawlers (Slack, Twitter/X, etc.) can fetch it directly.
const ogImage = new URL("/api/og.png", Astro.url).href;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/monaspace-neon-regular.woff2"
            crossorigin
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <style is:global>
            @font-face {
                font-family: "Monaspace Neon Var";
                font-weight: 400;
                font-style: normal;
                font-display: swap;
                src: url("/fonts/monaspace-neon-regular.woff2") format("woff2");
            }
            :root {
                color-scheme: dark;
                /* cjs26 palette */
                --color-service-black: #1f1b21;
                --color-violet-400: #a697fc;
                --rule: var(--color-violet-400);
            }
            * {
                box-sizing: border-box;
            }
            /* Author `display` rules on .btn etc. otherwise override the
               UA `[hidden] { display: none }` and leave hidden elements
               visible. Force the semantic. */
            [hidden] {
                display: none !important;
            }
            body {
                font:
                    16px/1.5 "Monaspace Neon Var",
                    ui-monospace,
                    "SF Mono",
                    Menlo,
                    monospace;
                background: var(--color-service-black);
                color: var(--color-violet-400);
                margin: 0;
                padding: 2.25rem 1.25rem 3rem;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                text-transform: uppercase;
            }
            main {
                max-width: 56rem;
                margin: 0 auto;
                width: 100%;
                flex: 1;
                display: flex;
                flex-direction: column;
            }
            code,
            kbd {
                font-family: "Monaspace Neon Var", ui-monospace, monospace;
                background: color-mix(in srgb, currentColor 12%, transparent);
                padding: 0.1em 0.35em;
                border-radius: 4px;
            }
            a {
                color: inherit;
            }
            button,
            input,
            select,
            textarea {
                font-family:
                    "Monaspace Neon Var", ui-monospace, "SF Mono", Menlo,
                    monospace;
            }
            button {
                font: inherit;
                font-family:
                    "Monaspace Neon Var", ui-monospace, "SF Mono", Menlo,
                    monospace;
                text-transform: uppercase;
                cursor: pointer;
            }
        </style>
    </head>
    <body>
        <main>
            <slot />
        </main>
    </body>
</html>
